# OpenAI
OPENAI_API_KEY=
# Optional: default text-embedding-3-small
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Confluence Cloud — base host (with or without /wiki)
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# CQL selecting SOP pages, e.g. label = "sop" and type = page
CONFLUENCE_SOP_CQL=label = "sop" and type = page

# Slack — create a Slack app, add Bot Token Scopes: channels:history, chat:write
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
# Socket Mode (recommended for local/dev): add app-level token with connections:write
SLACK_APP_TOKEN=xapp-
# Optional: restrict to one channel ID (omit to allow all channels the bot is in)
# Example archive URL …/archives/C0AT8QGTV8X → use C0AT8QGTV8X as the ID
# SLACK_SUPPORT_CHANNEL_ID=C0AT8QGTV8X
# Optional: set true to run matching on thread replies too (default: root messages only)
# SLACK_PROCESS_THREAD_REPLIES=false
# Optional: workflows posting as bot_message — enable and set SLACK_APP_ID to avoid loops
# SLACK_ALLOW_BOT_TICKETS=false
# SLACK_APP_ID=A0123456789

# Vector store: "local" (JSON file) or "pinecone"
VECTOR_BACKEND=local
LOCAL_VECTOR_PATH=.data/sop-vectors.json

# Pinecone — only if VECTOR_BACKEND=pinecone (index must use dimension 1536 for text-embedding-3-small)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_NAMESPACE=sops

# Tuning
# CHUNK_SIZE_CHARS=3500
# CHUNK_OVERLAP_CHARS=400
# TOP_K_SOPS=3

PORT=3000
