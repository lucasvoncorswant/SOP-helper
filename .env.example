# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Confluence Cloud — base host (with or without /wiki)
CONFLUENCE_BASE_URL=https://your-site.atlassian.net
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=
# CQL selecting SOP pages, e.g. label = "sop" and type = page
CONFLUENCE_SOP_CQL=label = "sop" and type = page
# Optional: numeric page ID(s) of folder root page(s). Limits search to that page + all nested pages (subfolders). Get ID from page URL …/pages/123456789/… or page info.
CONFLUENCE_SOP_ROOT_PAGE_IDS=5357142043

# Slack — only required for `npm run dev` / `npm start` (not for `npm run match-ticket`)
# Slack — create a Slack app, add Bot Token Scopes: channels:history, chat:write
SLACK_BOT_TOKEN=xoxb-
SLACK_SIGNING_SECRET=
# Socket Mode (recommended for local/dev): add app-level token with connections:write
SLACK_APP_TOKEN=xapp-1-A0ATJBTE0MR-10936420819283-0bbdfb296a5de668d401cbb6398d0e77400d5571413d29e8b9c61846efb9aece
#xoxe.xoxp-1-Mi0yLTI5NjQ3MTkxMjg3NjktODk1MDMwNDExOTc3Ni0xMDk0MDY4NDYyNzcxOC0xMDkyNzI5NDAxMjAwNy1jZTFmNGY3MmU3OWYxMzgyOGExYTBjZTllYjAyNTM5Y2Q5NGFkZmFkZjQ4YjMyZWM3MGIwNmNhNzMxODk2Y2E4
# Optional: restrict to one channel ID (omit to allow all channels the bot is in)
# Example archive URL …/archives/C0AT8QGTV8X → use C0AT8QGTV8X as the ID
# SLACK_SUPPORT_CHANNEL_ID=C0AT8QGTV8X
# Optional: set true to run matching on thread replies too (default: root messages only)
# SLACK_PROCESS_THREAD_REPLIES=false
# Optional: workflows posting as bot_message — enable and set SLACK_APP_ID to avoid loops
# SLACK_ALLOW_BOT_TICKETS=false
# SLACK_APP_ID=A0123456789

    # 1. Create or open the app
    # Go to api.slack.com/apps → Create New App → From scratch (or open an existing app).
    # Pick a name and development workspace → Create App.
    # 2. Turn on Socket Mode (for local / no public URL)
    # In the left sidebar: Settings → Socket Mode → turn Enable Socket Mode On.
    # Slack will ask for an app-level token: create one with scope connections:write (name it e.g. socket-mode).
    # Copy the token — that value is your SLACK_APP_TOKEN (starts with xapp-).
    # Your Bolt app uses this so events are delivered over a WebSocket instead of HTTP.

    # 3. Bot token scopes
    # OAuth & Permissions → Scopes → Bot Token Scopes.
    # Add at least:
    # channels:history — read messages in public channels the app is in.
    # chat:write — post thread replies.
    # If tickets are in a private channel, also add groups:history (private channels).
    # (Reinstall the app after changing scopes; see step 5.)

#at this step

    # 4. Event Subscriptions (which events the app receives)
    # Event Subscriptions → turn Enable Events On.
    # Under Subscribe to bot events, Add Bot User Event and add:
    # message.channels — messages in public channels.
    # If you use private channels for tickets, also add message.groups.
    # You do not need a public Request URL for delivery when Socket Mode is on; Bolt connects with the app-level token and still requires these subscriptions so Slack knows which events to send.

    # 5. Install the app to the workspace
    # Install App (or OAuth & Permissions → Install to Workspace).
    # Copy Bot User OAuth Token → that is SLACK_BOT_TOKEN (xoxb-).
    # 6. Put tokens in .env
    # SLACK_BOT_TOKEN — from OAuth (Bot User OAuth Token).
    # SLACK_SIGNING_SECRET — Basic Information → App Credentials → Signing Secret.
    # SLACK_APP_TOKEN — the Socket Mode app-level token (xapp-).
    # 7. Invite the bot to the channel
    # In Slack: open the support channel → /invite @YourAppName so it can read messages and post.

# Vector store: "local" (JSON file) or "pinecone"
VECTOR_BACKEND=local
LOCAL_VECTOR_PATH=.data/sop-vectors.json

# Pinecone — only if VECTOR_BACKEND=pinecone (index must use dimension 1536 for text-embedding-3-small)
# PINECONE_API_KEY=
# PINECONE_INDEX_NAME=
# PINECONE_NAMESPACE=sops

# Tuning
# CHUNK_SIZE_CHARS=3500
# CHUNK_OVERLAP_CHARS=400
# TOP_K_SOPS=3

PORT=3000
